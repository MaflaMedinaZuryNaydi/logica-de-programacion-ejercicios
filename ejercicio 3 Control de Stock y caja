Algoritmo Controlstock

	Definir opcion, stockactual, cantcomprar Como Entero
	Definir subtotal, descuento, totalpagar, recaudototal Como Real
	
	
	recaudototal <- 0
	
	Escribir "============================================="
	Escribir "    CONFIGURACION INICIAL DE INVENTARIO      "
	Escribir "============================================="
	Escribir "Ingrese la cantidad inicial de sacos en bodega:"
	Leer stockactual
	
	Mientras stockactual <= 0 Hacer
		Escribir "Error: La cantidad inicial debe ser mayor a cero. Intente de nuevo:"
		Leer stockactual
	FinMientras
	
	Repetir
		Escribir ""
		Escribir "============================================="
		Escribir "   ALMACEN AGROINSUMOS DEL VALLE - CAJA      "
		Escribir "============================================="
		Escribir "1. Realizar una venta"
		Escribir "2. Consultar stock disponible"
		Escribir "3. Realizar cierre de caja y salir"
		Escribir "Seleccione una opcion (1-3):"
		Leer opcion
		
		Segun opcion Hacer
			1:
				Escribir ""
				Escribir "--- REGISTRO DE VENTA DE FERTILIZANTE ---"
				Escribir "Ingrese la cantidad de sacos que desea llevar el cliente:"
				Leer cantcomprar
				
				Mientras cantcomprar <= 0 Hacer
					Escribir "Error: La cantidad a comprar debe ser mayor a cero. Intente de nuevo:"
					Leer cantcomprar
				FinMientras
				
				Si cantcomprar > stockactual Entonces
					Escribir ""
					Escribir "¡ALERTA!: Stock insuficiente. Solo quedan ", stockactual, " sacos en bodega."
					Escribir "Transaccion cancelada."
				Sino
					subtotal <- cantcomprar * 85000
				
					Si cantcomprar >= 10 Entonces
						descuento <- subtotal * 0.08
						Escribir "-> ¡Descuento del 8% aplicado por compra al por mayor!"
					Sino
						descuento <- 0
					FinSi
					
					totalpagar <- subtotal - descuento

					stockactual <- stockactual - cantcomprar
					recaudototal <- recaudototal + totalpagar
	
					Escribir "--- DETALLE DE LA VENTA ---"
					Escribir "Sacos comprados: ", cantcomprar
					Escribir "Subtotal: $", subtotal
					Escribir "Descuento aplicado: $", descuento
					Escribir "Total a pagar: $", totalpagar
					Escribir "Stock restante en bodega: ", stockactual
				FinSi
				
			2:
				Escribir "--- CONSULTA DE STOCK EN TIEMPO REAL ---"
				Escribir "Sacos de fertilizante disponibles en bodega: ", stockactual
				
			3:
				Escribir "============================================="
				Escribir "           CIERRE DE CAJA Y BALANCE          "
				Escribir "============================================="
				Escribir "Total de dinero recaudado: $", recaudototal
				Escribir "Sacos restantes en bodega al final del turno: ", stockactual
				Escribir "¡Cierre de caja exitoso! Cerrando sistema..."
				
			De Otro Modo:
				Escribir "Opcion no valida. Por favor intente de nuevo."
		FinSegun
		
	Hasta Que opcion = 3

FinAlgoritmo
